{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@bpflow/react": ["../../engine/react/src/index.ts"],
      "@bpflow/system": ["../../engine/system/src/index.ts"]
    }
  }
}