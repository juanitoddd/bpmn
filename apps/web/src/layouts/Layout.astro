---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen antialiased">
		<div class="bpmn-site-shell">
			<nav class="bpmn-site-nav" aria-label="Main navigation">
				<a class="bpmn-site-nav__brand" href="/" aria-label="Goodsole BPMN home">
					<span class="bpmn-site-nav__mark" aria-hidden="true">g</span>
					<span>goodsole<span class="bpmn-site-nav__brand-suffix"> / process lab</span></span>
				</a>
				<div class="bpmn-site-nav__links">
					<details class="bpmn-examples-menu">
						<summary aria-current={currentPath === '/' || currentPath.startsWith('/furniture') ? 'page' : undefined}>
							Examples
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path d="m4 6 4 4 4-4" />
							</svg>
						</summary>
						<div class="bpmn-examples-menu__panel">
							<p>PROCESS EXAMPLES</p>
							<a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
								<span>Shoe order</span>
								<small>Online shop · Goodsole</small>
							</a>
							<a href="/furniture" aria-current={currentPath.startsWith('/furniture') ? 'page' : undefined}>
								<span>Furniture order</span>
								<small>Seller &amp; supplier · Atelier Noir</small>
							</a>
						</div>
					</details>
					<a href="/learn" aria-current={currentPath.startsWith('/learn') ? 'page' : undefined}>Learn BPMN</a>
				</div>
			</nav>
			<slot />
		</div>
	</body>
</html>
